# HireReady Backend — Environment Variables
# Copy this to .env and fill in your values

# ----------------- AI API Keys (Choose Groq, Gemini, or OpenAI) -----------------
# Groq (FREE & Super Fast - Recommended for LLM & Mock Interview Whisper Speech):
# Get free key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Google Gemini (FREE - Recommended for Embeddings & LLM):
# Get free key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# ----------------- Frontend & Security -----------------
# Frontend URL(s) for CORS — comma-separated for multiple origins
# Local: http://localhost:5173
# Production: https://your-hireready-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ----------------- Firebase Configuration -----------------
# Firebase Service Account JSON (paste entire JSON string on Render / Railway)
FIREBASE_SERVICE_ACCOUNT=

# Firebase Storage Bucket (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ----------------- GitHub OAuth (Optional) -----------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/github/callback

# ----------------- Server Port -----------------
# PORT=8000
